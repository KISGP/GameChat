    "electron": "^42.3.0"
  },
  "devDependencies": {
    "@langfuse/core": "^5.14.0",
    "@langfuse/langchain": "^5.14.0",
    "@langfuse/otel": "^5.14.0",
    "@langfuse/tracing": "^5.14.0",
