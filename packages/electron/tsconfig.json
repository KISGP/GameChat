{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@gamechat/core": ["../core/src/index.ts"],
      "@gamechat/core/*": ["../core/src/*"],
      "@gamechat/schema": ["../schema/src/index.ts"],
      "@gamechat/type": ["../type/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
