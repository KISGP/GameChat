{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@gamechat/electron": ["../../packages/electron/src/index.ts"],
      "@gamechat/electron/preload": ["../../packages/electron/src/preload/index.ts"],
      "@gamechat/schema": ["../../packages/schema/src/index.ts"],
      "@gamechat/type": ["../../packages/type/src/index.ts"],
      "@gamechat/core": ["../../packages/core/src/index.ts"],
      "@gamechat/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["src/main/index.ts", "src/preload/index.ts", "electron.vite.config.ts"]
}
